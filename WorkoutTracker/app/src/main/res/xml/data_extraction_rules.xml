<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud-backup and device-transfer allowlists for user-created data. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="workout-tracker.db" />
        <include domain="file" path="datastore/workout_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="workout-tracker.db" />
        <include domain="file" path="datastore/workout_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
